rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin status is granted by a protected admins/{uid} document or verified admin email.
    function admin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || request.auth.token.email in ['yazan.bos900@gmail.com', 'manassatpro@gmail.com']
      );
    }

    function profileRole(uid, role) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == role;
    }

    function providerApproved(uid) {
      return exists(/databases/$(database)/documents/providers/$(uid))
        && (get(/databases/$(database)/documents/providers/$(uid)).data.accredited == true
          || get(/databases/$(database)/documents/providers/$(uid)).data.verificationStatus == 'approved');
    }

    function validTimestamp(value) {
      return value is string && value.size() > 0 && value.size() <= 64;
    }

    match /users/{userId} {
      allow get: if owner(userId) || admin();
      allow list: if admin();
      allow create: if owner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'provider', 'admin']
        && (request.resource.data.role != 'admin' || admin())
        && request.resource.data.createdAt is string
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'photoURL', 'phoneNumber',
          'providerCategory', 'institutionName', 'logoUrl', 'createdAt'
        ]);
      allow update: if admin() || (owner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'phoneNumber', 'providerCategory',
          'institutionName', 'logoUrl', 'updatedAt'
        ]));
      allow delete: if admin();

      match /savedServices/{serviceId} {
        allow read: if owner(userId) || admin();
        allow create: if owner(userId)
          && request.resource.data.serviceId == serviceId
          && validTimestamp(request.resource.data.createdAt)
          && request.resource.data.keys().hasOnly(['serviceId', 'createdAt']);
        allow update: if false;
        allow delete: if owner(userId) || admin();
      }

      match /notifications/{notificationId} {
        allow read: if owner(userId) || admin();
        allow create: if owner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.message is string
          && request.resource.data.read is bool
          && request.resource.data.type in ['booking', 'reminder', 'system', 'offer']
          && request.resource.data.keys().hasOnly([
            'title', 'message', 'date', 'read', 'type', 'userId',
            'createdAt', 'updatedAt', 'link'
          ]);
        allow update: if admin() || (owner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt'])
          && request.resource.data.read is bool);
        allow delete: if owner(userId) || admin();
      }

      match /teamMembers/{memberId} {
        allow read: if owner(userId) || admin();
        allow create: if owner(userId)
          && request.resource.data.name is string
          && request.resource.data.email is string
          && request.resource.data.keys().hasOnly([
            'name', 'role', 'department', 'email', 'phone', 'status', 'createdAt', 'updatedAt'
          ]);
        allow update, delete: if owner(userId) || admin();
      }
    }

    match /admins/{adminId} {
      allow get: if owner(adminId) || admin();
      allow list, create, update, delete: if admin();
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if admin();
    }

    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if admin();
    }

    // Provider profile fields are part of the public directory; private account data stays in users/{uid}.
    match /providers/{providerId} {
      allow get, list: if true;
      allow create: if ((owner(providerId)
        && profileRole(providerId, 'provider')
        && request.resource.data.providerId == providerId
        && request.resource.data.accredited == false) || admin());
      allow update: if admin() || (owner(providerId)
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'nameEn', 'category', 'city', 'description', 'contactEmail',
          'contactPhone', 'servicesOffered', 'tags', 'website', 'address',
          'coverColor', 'logoUrl', 'coverImageUrl', 'documents', 'establishedYear', 'accreditationBody',
          'licenseNumber', 'city', 'verificationStatus',
          'submittedAt', 'updatedAt'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'accredited']) || request.resource.data.verificationStatus == 'pending')
        && request.resource.data.accredited == resource.data.accredited);
      allow delete: if admin();
    }

    match /services/{serviceId} {
      allow get, list: if true;
      allow create: if signedIn()
        && profileRole(request.auth.uid, 'provider')
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.numericPrice is number
        && request.resource.data.numericPrice >= 0
        && request.resource.data.status in ['draft', 'active', 'closed']
        && (request.resource.data.status != 'active' || providerApproved(request.auth.uid));
      allow update: if admin() || (signedIn()
        && resource.data.providerId == request.auth.uid
        && request.resource.data.providerId == resource.data.providerId
        && (request.resource.data.status != 'active' || providerApproved(request.auth.uid) || resource.data.status == 'active')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'category', 'level', 'duration', 'priceNote', 'numericPrice',
          'currency', 'description', 'seatsAvailable', 'totalSeats', 'status',
          'mode', 'modules', 'schedule', 'instructorName', 'instructorRole',
          'prerequisites', 'featured', 'imageUrl', 'syllabusUrl', 'syllabusFileName',
          'syllabusFileSize', 'updatedAt'
        ]));
      allow delete: if admin() || (signedIn() && resource.data.providerId == request.auth.uid);
    }

    match /inquiries/{inquiryId} {
      allow get, list: if signedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.providerId == request.auth.uid
        || admin()
      );
      allow create: if signedIn()
        && profileRole(request.auth.uid, 'student')
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.serviceId is string
        && exists(/databases/$(database)/documents/services/$(request.resource.data.serviceId))
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.providerId == request.resource.data.providerId
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.status == 'active'
        && (providerApproved(request.resource.data.providerId) || exists(/databases/$(database)/documents/providers/$(request.resource.data.providerId)))
        && request.resource.data.keys().hasOnly([
          'studentId', 'studentName', 'studentEmail', 'providerId', 'providerName',
          'serviceId', 'serviceTitle', 'date', 'status', 'notes', 'createdAt', 'updatedAt'
        ]);
      allow update: if admin() || (signedIn()
        && resource.data.providerId == request.auth.uid
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'responseNote', 'interviewDate', 'internalNotes', 'updatedAt'
        ])
        && request.resource.data.status in ['responded', 'confirmed', 'rejected']);
      allow delete: if admin() || (signedIn() && resource.data.studentId == request.auth.uid);
    }

    match /enrollments/{enrollmentId} {
      allow get, list: if signedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.providerId == request.auth.uid
        || admin()
      );
      allow create: if signedIn()
        && profileRole(request.auth.uid, 'student')
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.paymentMethod == 'wire_transfer'
        && request.resource.data.courseId is string
        && exists(/databases/$(database)/documents/services/$(request.resource.data.courseId))
        && get(/databases/$(database)/documents/services/$(request.resource.data.courseId)).data.providerId == request.resource.data.providerId
        && get(/databases/$(database)/documents/services/$(request.resource.data.courseId)).data.status == 'active'
        && (providerApproved(request.resource.data.providerId) || exists(/databases/$(database)/documents/providers/$(request.resource.data.providerId)))
        && request.resource.data.amount == get(/databases/$(database)/documents/services/$(request.resource.data.courseId)).data.numericPrice
        && request.resource.data.keys().hasOnly([
          'studentId', 'providerId', 'courseId', 'courseTitle', 'providerName',
          'studentName', 'studentEmail', 'studentPhone', 'amount', 'currency',
          'bookingDate', 'startDate', 'status', 'paymentStatus', 'paymentMethod',
          'transactionId', 'createdAt', 'updatedAt'
        ]);
      allow update: if admin() || (signedIn()
        && resource.data.providerId == request.auth.uid
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt'])
        && request.resource.data.status in ['confirmed', 'rejected', 'cancelled', 'pending']
        && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['pending', 'paid', 'installments', 'overdue', 'failed', 'refunded']));
      allow delete: if admin();
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if admin() || (signedIn()
        && resource.data.providerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['providerReply', 'updatedAt']));
      allow delete: if admin() || (signedIn() && resource.data.studentId == request.auth.uid);
    }

    // Root-level notifications are intentionally closed; each account reads its private subcollection above.
    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    match /siteSettings/{settingId} {
      allow get: if settingId == 'homepageBanners';
      allow list: if false;
      allow create, update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
